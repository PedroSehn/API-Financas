{
  "info": {
    "name": "Finança API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pedro@financas.com\",\n  \"password\": \"pedro123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Salary",
      "item": [
        {
          "name": "Get Salary Config",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/salary",
              "host": ["{{baseUrl}}"],
              "path": ["salary"]
            }
          }
        },
        {
          "name": "Create Salary Config",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gross_salary\": 5000,\n  \"has_inss\": true,\n  \"has_irrf\": true,\n  \"vt_percentage\": 6,\n  \"health_plan\": 150,\n  \"other_discounts\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/salary",
              "host": ["{{baseUrl}}"],
              "path": ["salary"]
            }
          }
        },
        {
          "name": "Update Salary Config",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gross_salary\": 5500,\n  \"has_inss\": true,\n  \"has_irrf\": true,\n  \"vt_percentage\": 6,\n  \"health_plan\": 150,\n  \"other_discounts\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/salary",
              "host": ["{{baseUrl}}"],
              "path": ["salary"]
            }
          }
        }
      ]
    },
    {
      "name": "Incomes",
      "item": [
        {
          "name": "Get Incomes by Month",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/incomes?year=2026&month=4",
              "host": ["{{baseUrl}}"],
              "path": ["incomes"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "month", "value": "4" }
              ]
            }
          }
        },
        {
          "name": "Create Income",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Salário\",\n  \"emoji\": \"💰\",\n  \"value\": 3000,\n  \"type\": \"salary\",\n  \"start_month\": 1,\n  \"start_year\": 2026,\n  \"duration_months\": 999\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incomes",
              "host": ["{{baseUrl}}"],
              "path": ["incomes"]
            }
          }
        },
        {
          "name": "Update Income",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Salário\",\n  \"emoji\": \"💰\",\n  \"value\": 3500,\n  \"type\": \"salary\",\n  \"start_month\": 1,\n  \"start_year\": 2026,\n  \"duration_months\": 999\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/incomes/:id",
              "host": ["{{baseUrl}}"],
              "path": ["incomes", ":id"],
              "variable": [
                { "key": "id", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Delete Income",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/incomes/:id",
              "host": ["{{baseUrl}}"],
              "path": ["incomes", ":id"],
              "variable": [
                { "key": "id", "value": "1" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Get Expenses by Month",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/expenses?year=2026&month=4",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "month", "value": "4" }
              ]
            }
          }
        },
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Aluguel\",\n  \"emoji\": \"🏠\",\n  \"value\": 1500,\n  \"category\": \"moradia\",\n  \"start_month\": 1,\n  \"start_year\": 2026,\n  \"duration_months\": 999\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"]
            }
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Aluguel\",\n  \"emoji\": \"🏠\",\n  \"value\": 1800,\n  \"category\": \"moradia\",\n  \"start_month\": 1,\n  \"start_year\": 2026,\n  \"duration_months\": 999\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expenses/:id",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", ":id"],
              "variable": [
                { "key": "id", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/expenses/:id",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", ":id"],
              "variable": [
                { "key": "id", "value": "1" }
              ]
            }
          }
        }
      ]
    }
  ]
}
